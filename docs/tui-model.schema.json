{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/asb-tui/blob/main/docs/tui-model.schema.json",
  "title": "ASB TUI formal state model",
  "type": "object",
  "required": ["schema_version", "routes", "elements", "transitions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "routes": {"type":"array", "items":{"$ref":"#/$defs/route"}, "minItems":1},
    "elements": {"type":"array", "items":{"$ref":"#/$defs/element"}, "minItems":1},
    "transitions": {"type":"array", "items":{"$ref":"#/$defs/transition"}, "minItems":1}
  },
  "$defs": {
    "route": {
      "type":"object", "required":["id","title","entry","availability"], "additionalProperties":false,
      "properties":{"id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"entry":{"type":"boolean"},"availability":{"type":"string","minLength":1}}
    },
    "element": {
      "type":"object", "required":["id","route","kind","label","help_id","visibility","state_bindings"], "additionalProperties":false,
      "properties":{"id":{"type":"string","minLength":1},"route":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"help_id":{"type":"string","minLength":1},"visibility":{"type":"string","minLength":1},"state_bindings":{"type":"array","items":{"type":"string","minLength":1},"minItems":1}}
    },
    "transition": {
      "type":"object", "required":["id","from","event","to","guard","effects"], "additionalProperties":false,
      "properties":{"id":{"type":"string","minLength":1},"from":{"type":"string","minLength":1},"event":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},"guard":{"type":"string","minLength":1},"effects":{"type":"array","items":{"type":"string","minLength":1},"minItems":1}}
    }
  }
}
