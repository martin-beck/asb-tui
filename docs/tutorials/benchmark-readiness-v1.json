    {"id": "auth-status", "command": ["asb", "auth", "status", "--provider", "synthetic-provider"], "expect": "auth-status-v1"},
    {"id": "tui-doctor", "command": ["asb", "tui", "doctor"], "expect": "readiness-doctor-v1"}
  ]
}
