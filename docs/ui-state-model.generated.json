{
  "schema_version": 1,
  "model": "asb-tui.ui-state",
  "initial": "landing",
  "layouts": [
    "wide",
    "compact",
    "tiny"
  ],
  "state_fields": [
    "route",
    "focus",
    "hover",
    "query",
    "selection",
    "connection",
    "capabilities",
    "startup_wizard_opened",
    "responsive_layout",
    "contextual_help",
    "wizard_step",
    "wizard_draft",
    "configuration_persistence"
  ],
  "bindings": [
    {
      "action": "quit",
      "element": "navigation",
      "key": "q"
    },
    {
      "action": "open_measurement_selection",
      "element": "landing.primary",
      "key": "2"
    },
    {
      "action": "open_configuration",
      "element": "landing.primary",
      "key": "3"
    },
    {
      "action": "open_wizard",
      "element": "landing.primary",
      "key": "w"
    },
    {
      "action": "wizard_next",
      "element": "wizard.review",
      "key": "Enter"
    },
    {
      "action": "wizard_back",
      "element": "navigation",
      "key": "Esc"
    },
    {
      "action": "cancel_wizard",
      "element": "navigation",
      "key": "q"
    },
    {
      "action": "open_help",
      "element": "navigation",
      "key": "?"
    },
    {
      "action": "focus_measure_search",
      "element": "measures.search",
      "key": "/"
    },
    {
      "action": "toggle_measure",
      "element": "measures.row",
      "key": "Space"
    },
    {
      "action": "toggle_group",
      "element": "measures.group_toggle",
      "key": "g"
    }
  ],
  "routes": [
    {
      "id": "landing",
      "elements": [
        "landing.primary",
        "navigation",
        "status.connection"
      ]
    },
    {
      "id": "wizard",
      "elements": [
        "wizard.agent",
        "wizard.provider",
        "wizard.model",
        "wizard.configuration",
        "wizard.authentication",
        "wizard.recording",
        "wizard.replay",
        "wizard.review",
        "navigation"
      ]
    },
    {
      "id": "measurement_selection",
      "elements": [
        "measures.search",
        "measures.row",
        "measures.group_toggle",
        "navigation"
      ]
    },
    {
      "id": "configuration",
      "elements": [
        "configuration.entry",
        "configuration.search",
        "navigation"
      ]
    },
    {
      "id": "run_control",
      "elements": [
        "run.status",
        "run.start",
        "run.cancel",
        "navigation"
      ]
    },
    {
      "id": "recent_runs",
      "elements": [
        "runs.row",
        "runs.refresh",
        "navigation"
      ]
    },
    {
      "id": "reports",
      "elements": [
        "reports.row",
        "reports.compare",
        "navigation"
      ]
    },
    {
      "id": "help",
      "elements": [
        "help.search",
        "help.entry",
        "navigation"
      ]
    }
  ],
  "elements": [
    {
      "id": "landing.primary",
      "route": "landing",
      "role": "action",
      "help_id": "screen.landing",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "measures.search",
      "route": "measurement_selection",
      "role": "editable",
      "help_id": "measures.search",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "measures.row",
      "route": "measurement_selection",
      "role": "selectable",
      "help_id": "measures.row",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "measures.group_toggle",
      "route": "measurement_selection",
      "role": "action",
      "help_id": "measures.group_toggle",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "configuration.entry",
      "route": "configuration",
      "role": "editable",
      "help_id": "configuration.entry",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "configuration.search",
      "route": "configuration",
      "role": "editable",
      "help_id": "configuration.search",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "run.status",
      "route": "run_control",
      "role": "status",
      "help_id": "run.status",
      "focusable": false,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "run.start",
      "route": "run_control",
      "role": "action",
      "help_id": "run.start",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "run.cancel",
      "route": "run_control",
      "role": "action",
      "help_id": "run.cancel",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "runs.row",
      "route": "recent_runs",
      "role": "selectable",
      "help_id": "runs.row",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "runs.refresh",
      "route": "recent_runs",
      "role": "action",
      "help_id": "runs.refresh",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "reports.row",
      "route": "reports",
      "role": "selectable",
      "help_id": "reports.row",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "reports.compare",
      "route": "reports",
      "role": "action",
      "help_id": "reports.compare",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "help.search",
      "route": "help",
      "role": "editable",
      "help_id": "help.search",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "help.entry",
      "route": "help",
      "role": "selectable",
      "help_id": "help.entry",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "navigation",
      "route": "global",
      "role": "navigation",
      "help_id": "navigation",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "status.connection",
      "route": "landing",
      "role": "status",
      "help_id": "status.connection",
      "focusable": false,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.agent",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.agent",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.provider",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.provider",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.model",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.model",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.configuration",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.configuration",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.authentication",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.authentication",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.recording",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.recording",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.replay",
      "route": "wizard",
      "role": "editable",
      "help_id": "wizard.replay",
      "focusable": true,
      "hoverable": true,
      "parent": null
    },
    {
      "id": "wizard.review",
      "route": "wizard",
      "role": "status",
      "help_id": "wizard.review",
      "focusable": true,
      "hoverable": true,
      "parent": null
    }
  ],
  "transitions": [
    {
      "event": "open_wizard",
      "from": "landing",
      "to": "wizard",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "wizard_next",
      "from": "wizard",
      "to": "wizard",
      "effects": [
        "wizard_step_changed",
        "focus_reset"
      ]
    },
    {
      "event": "wizard_back",
      "from": "wizard",
      "to": "wizard",
      "effects": [
        "wizard_step_changed",
        "focus_reset"
      ]
    },
    {
      "event": "wizard_set_value",
      "from": "wizard",
      "to": "wizard",
      "effects": [
        "wizard_draft_changed",
        "focus_reset"
      ]
    },
    {
      "event": "complete_wizard",
      "from": "wizard",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "cancel_wizard",
      "from": "wizard",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_measurement_selection",
      "from": "landing",
      "to": "measurement_selection",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_configuration",
      "from": "landing",
      "to": "configuration",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_help",
      "from": "landing",
      "to": "help",
      "effects": [
        "return_route_saved",
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_landing",
      "from": "measurement_selection",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_run_control",
      "from": "measurement_selection",
      "to": "run_control",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_help",
      "from": "measurement_selection",
      "to": "help",
      "effects": [
        "return_route_saved",
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_landing",
      "from": "configuration",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_measurement_selection",
      "from": "configuration",
      "to": "measurement_selection",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_help",
      "from": "configuration",
      "to": "help",
      "effects": [
        "return_route_saved",
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_landing",
      "from": "run_control",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_recent_runs",
      "from": "run_control",
      "to": "recent_runs",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_help",
      "from": "run_control",
      "to": "help",
      "effects": [
        "return_route_saved",
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_landing",
      "from": "recent_runs",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_reports",
      "from": "recent_runs",
      "to": "reports",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_help",
      "from": "recent_runs",
      "to": "help",
      "effects": [
        "return_route_saved",
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_landing",
      "from": "reports",
      "to": "landing",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "open_help",
      "from": "reports",
      "to": "help",
      "effects": [
        "return_route_saved",
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "go_back",
      "from": "help",
      "to": "landing",
      "effects": [
        "route_restored",
        "focus_reset"
      ]
    }
  ],
  "help": [
    {
      "id": "screen.landing",
      "text": "Choose a benchmark task or open another screen."
    },
    {
      "id": "wizard.agent",
      "text": "Choose the agent that will execute this benchmark."
    },
    {
      "id": "wizard.provider",
      "text": "Choose the provider for the selected agent model."
    },
    {
      "id": "wizard.model",
      "text": "Choose the model exposed by the selected provider."
    },
    {
      "id": "wizard.configuration",
      "text": "Review benchmark settings before continuing."
    },
    {
      "id": "wizard.authentication",
      "text": "Select the authentication reference for this provider."
    },
    {
      "id": "wizard.recording",
      "text": "Choose whether to record benchmark activity."
    },
    {
      "id": "wizard.replay",
      "text": "Choose the offline replay policy for this benchmark."
    },
    {
      "id": "wizard.review",
      "text": "Review every setup choice before completing the wizard."
    },
    {
      "id": "measures.search",
      "text": "Type to filter benchmark measures by group or name."
    },
    {
      "id": "measures.row",
      "text": "Select or clear this measure for the benchmark."
    },
    {
      "id": "measures.group_toggle",
      "text": "Select or clear every visible measure in this group."
    },
    {
      "id": "configuration.entry",
      "text": "Edit this setting; its value controls the next benchmark."
    },
    {
      "id": "configuration.search",
      "text": "Type to find a configuration setting by name or description."
    },
    {
      "id": "run.status",
      "text": "Shows whether the benchmark is idle, running, complete, or failed."
    },
    {
      "id": "run.start",
      "text": "Start a benchmark using the current configuration and measures."
    },
    {
      "id": "run.cancel",
      "text": "Stop the active benchmark while preserving its partial record."
    },
    {
      "id": "runs.row",
      "text": "Choose a completed run to inspect its report."
    },
    {
      "id": "runs.refresh",
      "text": "Reload the latest run history from ASB."
    },
    {
      "id": "reports.row",
      "text": "Choose a completed run to inspect its report."
    },
    {
      "id": "reports.compare",
      "text": "Compare the selected completed runs."
    },
    {
      "id": "help.search",
      "text": "Type to find an action or explanation."
    },
    {
      "id": "help.entry",
      "text": "Read the explanation and key for this action."
    },
    {
      "id": "navigation",
      "text": "Move between screens with the arrow keys or Tab."
    },
    {
      "id": "status.connection",
      "text": "Shows whether the ASB control connection is ready."
    }
  ]
}
