  "transitions": [
    {
      "event": "open_wizard",
      "from": "landing",
      "to": "wizard",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "startup_auto_open_wizard",
      "from": "landing",
      "to": "wizard",
      "effects": [
        "route_changed",
        "focus_reset"
      ]
    },
    {
      "event": "wizard_next",
