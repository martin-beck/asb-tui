  "help": [
    {
      "id": "screen.landing",
      "text": "Choose a benchmark task or open another screen."
    },
    {
      "id": "wizard.agent",
      "text": "Search and choose an available agent for this benchmark."
    },
    {
      "id": "wizard.provider",
      "text": "Search and choose a provider for the selected agent."
    },
    {
      "id": "wizard.model",
      "text": "Search and choose a model exposed by the selected provider."
    },
    {
      "id": "wizard.configuration",
      "text": "Review benchmark settings before continuing."
    },
    {
      "id": "wizard.authentication",
      "text": "Select the authentication reference for this provider."
    },
    {
      "id": "wizard.recording",
      "text": "Choose whether to record benchmark activity."
    },
    {
      "id": "wizard.replay",
      "text": "Choose the offline replay policy for this benchmark."
    },
    {
      "id": "wizard.review",
      "text": "Review every setup choice before completing the wizard."
    },
    {
      "id": "wizard.controls",
      "text": "Edit the active value, move between steps, or open contextual help."
    },
    {
      "id": "measures.search",
      "text": "Type to filter benchmark measures by group or name."
    },
    {
      "id": "measures.row",
      "text": "Select or clear this measure for the benchmark."
    },
    {
      "id": "measures.group_toggle",
      "text": "Select or clear every visible measure in this group."
    },
    {
      "id": "configuration.entry",
      "text": "Edit this setting and press Ctrl-S to apply the validated local draft through the local configuration store."
    },
    {
      "id": "configuration.search",
      "text": "Type to find a configuration setting by name or description."
    },
    {
      "id": "configuration.control_status",
      "text": "Inspect provider model, credential-free authentication status, and recording readiness reported by the authenticated runner."
    },
    {
      "id": "run.status",
      "text": "Shows whether the benchmark is idle, running, complete, or failed."
    },
    {
      "id": "run.start",
      "text": "Start a benchmark using the current configuration and measures."
    },
    {
      "id": "run.cancel",
      "text": "Stop the active benchmark while preserving its partial record."
    },
    {
      "id": "runs.row",
      "text": "Choose a completed run to inspect its report."
    },
    {
      "id": "runs.refresh",
      "text": "Reload the latest run history from ASB."
    },
    {
      "id": "reports.row",
      "text": "Choose a completed run to inspect its report."
    },
    {
      "id": "reports.compare",
      "text": "Compare the selected completed runs."
    },
    {
      "id": "help.search",
      "text": "Type to find an action or explanation."
    },
    {
      "id": "help.entry",
      "text": "Read the explanation and key for this action."
    },
    {
      "id": "navigation",
      "text": "Move between screens with the arrow keys or Tab."
    },
    {
      "id": "status.connection",
      "text": "Shows whether the ASB control connection is ready."
    }
  ]
}
