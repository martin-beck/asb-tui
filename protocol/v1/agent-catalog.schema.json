{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASB control v1.4 agent catalog response",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id", "result"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": "integer", "minimum": 0},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "operation"},
        "value": {
          "type": "object", "additionalProperties": false,
          "required": ["request_sha256", "result"],
          "properties": {
            "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "result": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": {"const": "agent_catalog"},
                "value": {"$ref": "#/$defs/catalog"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "token": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+:-]+$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "architecture", "libc", "libc_version"],
      "properties": {"operating_system": {"$ref": "#/$defs/token"}, "architecture": {"$ref": "#/$defs/token"}, "libc": {"$ref": "#/$defs/token"}, "libc_version": {"$ref": "#/$defs/token"}}
    },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_instance_id", "generation", "catalog_sha256", "target", "agents", "refreshed"],
      "properties": {
        "runner_instance_id": {"$ref": "#/$defs/token"}, "generation": {"type": "integer", "minimum": 0}, "catalog_sha256": {"$ref": "#/$defs/digest"}, "target": {"$ref": "#/$defs/target"}, "refreshed": {"type": "boolean"},
        "agents": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_id", "target", "capabilities", "availability"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/token"}, "target": {"$ref": "#/$defs/target"}, "package": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["package_id", "version", "sha256", "signature_sha256", "signer"], "properties": {"package_id": {"$ref": "#/$defs/token"}, "version": {"$ref": "#/$defs/token"}, "sha256": {"$ref": "#/$defs/digest"}, "signature_sha256": {"$ref": "#/$defs/digest"}, "signer": {"type": "object", "additionalProperties": false, "required": ["key_id", "principal"], "properties": {"key_id": {"$ref": "#/$defs/token"}, "principal": {"$ref": "#/$defs/token"}}}}}, {"type": "null"}]}, "provenance": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["source_revision", "manifest_sha256", "sbom_sha256", "license_ref"], "properties": {"source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifest_sha256": {"$ref": "#/$defs/digest"}, "sbom_sha256": {"$ref": "#/$defs/digest"}, "license_ref": {"$ref": "#/$defs/token"}}}, {"type": "null"}]}, "capabilities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}}, "availability": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "available"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}, "reason": {"enum": ["incompatible_target", "incomplete_provenance", "unverified_artifact", "missing_capability", "stale_catalog", "policy_denied"]}}}]}
      }
    }
  }
}
