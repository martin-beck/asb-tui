{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/asb-tui/protocol/v1/bundle-manifest.schema.json",
  "title": "asb-tui signed bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "source_commit", "source_tree", "issued_unix", "expires_unix", "compatibility", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "issued_unix": {"type": "integer", "minimum": 1},
    "expires_unix": {"type": "integer", "minimum": 1},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle", "architecture", "asb_version", "protocol_version", "coordinator_version", "coordinator_commit", "quality_version", "quality_commit"],
      "properties": {
        "bundle": {"type": "string", "enum": ["asb-tui-v1-linux-x86_64", "asb-tui-v1-linux-aarch64"]},
        "architecture": {"type": "string", "enum": ["x86_64", "aarch64"]},
        "asb_version": {"const": "0.1.0"},
        "protocol_version": {"const": 1},
        "coordinator_version": {"const": "v0.3.5"},
        "coordinator_commit": {"const": "510817b93feb80dde13e5a6c61d657954fae2346"},
        "quality_version": {"const": "v0.23.0"},
        "quality_commit": {"const": "8a9f056b7fc7926b9465a0f7a09225d4da1c572a"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "url", "size", "sha256"],
        "properties": {
          "name": {"type": "string", "enum": ["asb-tui", "source", "licenses", "sbom", "provenance"]},
          "kind": {"type": "string", "enum": ["executable", "source", "license_report", "sbom", "provenance"]},
          "url": {"type": "string", "pattern": "^https://github\\.com/martin-beck/asb-tui/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[^/?#%]+$", "maxLength": 256},
          "size": {"type": "integer", "minimum": 1, "maximum": 268435456},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
