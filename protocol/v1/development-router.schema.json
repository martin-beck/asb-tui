{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/asb-tui/blob/main/protocol/v1/development-router.schema.json",
  "title": "ASB TUI development router request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["router_version", "profile", "channel", "current_main", "request"],
  "properties": {
    "router_version": { "const": 1 },
    "profile": { "const": "development" },
    "channel": { "const": "dev" },
    "current_main": { "$ref": "#/$defs/currentMain" },
    "request": { "$ref": "lifecycle-request.schema.json" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "currentMain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asb_source_commit", "asb_source_tree", "tui_source_commit", "tui_source_tree"],
      "properties": {
        "asb_source_commit": { "$ref": "#/$defs/commit" },
        "asb_source_tree": { "$ref": "#/$defs/commit" },
        "tui_source_commit": { "$ref": "#/$defs/commit" },
        "tui_source_tree": { "$ref": "#/$defs/commit" }
      }
    }
  }
}
