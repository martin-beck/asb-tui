{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/asb-tui/blob/main/protocol/v1/lifecycle-request.schema.json",
  "title": "ASB TUI delegated lifecycle request v1",
  "anyOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "schema_version", "install_root"],
      "properties": {
        "operation": { "enum": ["status", "remove", "launch"] },
        "schema_version": { "const": 1 },
        "install_root": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "schema_version", "install_root", "manifest", "signature", "allowed_signers", "artifacts", "now_unix", "expected_bundle", "architecture", "asb_version"],
      "properties": {
        "operation": { "enum": ["install", "upgrade"] },
        "schema_version": { "const": 1 },
        "install_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "manifest": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "signature": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "allowed_signers": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "artifacts": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "now_unix": { "type": "integer", "minimum": 0 },
        "expected_bundle": { "enum": ["asb-tui-v1-linux-x86_64", "asb-tui-v1-linux-aarch64"] },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "asb_version": { "const": "0.1.0" }
      }
    }
  ]
}
